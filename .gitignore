# ==============================================================================
#  Kast —— 只提交源码与资源，不提交二进制与中间产物
#  结构：kast.sln + Kast.Core / Kast.Server / Kast.Test（普通 .NET）
#        + Kast.Godot（Godot 4 项目，含自己的 kast.csproj）
#        根目录 Assets/ 是建模工作区（.bbmodel/.js/预览图），不是 Godot 的资源目录
# ==============================================================================

# ------------------------------------------------------------------------------
# .NET / C# 构建产物
# ------------------------------------------------------------------------------
[Bb]in/
[Oo]bj/
*.dll
*.exe
*.pdb
*.mdb
*.nupkg
*.snupkg
*.binlog
*.cache
project.lock.json
artifacts/

# ------------------------------------------------------------------------------
# Godot 4
# ------------------------------------------------------------------------------
# 编辑器与导入缓存（.godot/mono/temp 下还有一份编译产物）
.godot/
# Godot 3 遗留
.import/
.mono/
data_*/
mono_crash.*.json

# 导出产物
*.pck
/build/
/export/
# Godot 编辑器“导出项目”的默认输出目录（Kast.exe / data_*.dll / kast.zip 等，
# 一次导出约 250 MB 且全为二进制，绝不入库）
/dist/
# 导出配置可能内含 Android 签名口令，按官方建议不入库
export_presets.cfg

# 由 CSV 导入生成的翻译资源；源文件是 Localization/strings.csv（已提交），
# Godot 打开项目时会依据 strings.csv.import 自动重新生成。
# 若希望翻译资源也入库，取消下面这行注释即可。
*.translation
# !Localization/*.translation

# 运行时 dump 的词典：NGame.cs 里 File.WriteAllText("words.csv", DB.AsText())
# Godot 会把它当 CSV 再导入一次，于是额外生成 .import 与 .translation
words.csv
words.csv.import

# 注意：下面两类文件要提交，不要加进忽略列表 ——
#   *.uid      Godot 4.4+ 的脚本/资源稳定 ID，删掉会导致引用失效
#   *.import   记录导入参数与 uid（words.csv.import 除外，见上）

# ------------------------------------------------------------------------------
# IDE / 编辑器
# ------------------------------------------------------------------------------
.vs/
.idea/
*.user
*.suo
*.userprefs
*.DotSettings.user
# .vscode/ 只有 dotnet.defaultSolution 一行配置，保留提交

# ------------------------------------------------------------------------------
# 临时 / 校验目录（.tmp-build-check 之类的离线编译校验工程，含自己的 bin/obj）
# ------------------------------------------------------------------------------
.tmp-*/

# ------------------------------------------------------------------------------
# DSH 编辑审查缓存（工具产物，不是项目文件，单个可达十几 MB）
# ------------------------------------------------------------------------------
.dsh-*

# ------------------------------------------------------------------------------
# 杂项
# ------------------------------------------------------------------------------
*.log
*.tmp
*.bak
*.orig
*.rej
# Blender 保存时自动留的上一版备份（Assets/*.blend 才是源文件）
*.blend[0-9]
Thumbs.db
Desktop.ini
